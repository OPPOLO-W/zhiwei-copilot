# ---------- Neo4j Desktop ----------
# 在 Neo4j Desktop 中创建/启动一个本地 DBMS，复制它的 Bolt URL 与密码。
# 注意：Desktop 每次可能分配不同端口（7687/7688/…），以 DBMS 详情页为准。
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
# true = 使用只读账号语义（Agent 只读；导入脚本单独使用写连接）
KG_READONLY=true

# ---------- 图存储后端 ----------
# neo4j = 真实图数据库；memory = 从 data/curated 加载，用于测试/离线演示
KG_BACKEND=neo4j

# ---------- LLM（OpenAI 兼容，可留空） ----------
# 留空则自动降级：Agent 走确定性规则兜底，不调用任何 LLM。
# 填 key 后：请求 /api/query 传 "useLlm": true 走 LLM 驱动 RefKG-lite；
# 评测用 python -m backend.app.eval.run_eval --system agent_llm。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0

# ---------- 运行参数 ----------
AGENT_MAX_STEPS=6
AGENT_MAX_REFLECTIONS=2
AGENT_TOKEN_BUDGET=24000
RULE_MAX_ITERATIONS=1000
RULE_MAX_DEPTH=8
CORS_ORIGINS=http://localhost:5173
TRACE_DIR=var/traces
